#!/bin/bash

URLs=(
  "https://platform.deepseek.com/usage"
  "https://zenmux.ai/platform/subscription"
  "https://opencode.ai/workspace/wrk_01KKS0RMCWW2C2FH33RSMBDTHK/go"
)

for url in ${URLs[@]}; do
  curl -s -X POST http://127.0.0.1:4321/api/svr/open-url \
    -u "admin:AAaa00__" \
    -H "Content-Type: application/json" \
    -d @- <<ENDJSON
{
  "browser": "chrome",
  "url": "$url"
}
ENDJSON
done
